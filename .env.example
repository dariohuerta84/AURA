# Copia este archivo como .env (en la raiz del proyecto) y ajusta lo que uses.
# manage.py lo lee solo; no hace falta instalar python-dotenv.

# --- Modo de prueba -----------------------------------------------------
# 1 = no llama a TripoSR y devuelve un avatar de juguete. Sirve para probar
# la cadena completa (React -> Django -> visor) sin instalar nada pesado.
# Ponlo en 0 cuando TripoSR ya funcione.
AVATAR_MOCK=1

# --- TripoSR ------------------------------------------------------------
# Carpeta donde clonaste https://github.com/VAST-AI-Research/TripoSR
TRIPOSR_REPO_PATH=C:/TripoSR
# Interprete del venv de TripoSR (el que tiene torch). Si lo dejas vacio se
# buscan .venv/venv dentro del repo.
TRIPOSR_PYTHON=
# auto | cuda | cpu
AVATAR_DEVICE=auto
# Segundos maximos por generacion (en CPU sube esto si se corta)
AVATAR_TIMEOUT=600
# Carpeta de trabajo donde TripoSR escribe antes de mover el mesh a media/
AVATAR_OUTPUT_DIR=

# --- Django -------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_ROOT=
TIME_ZONE=America/Lima

# --- Frontend / Convex (camino B) ------------------------------------
# La URL la imprime `npx convex dev`. Va en frontend/.env.local (ignorado
# por git), no aqui. Se deja documentada como referencia.
# VITE_CONVEX_URL=https://xxxx.convex.cloud
